    "grounding_supports": [
      {
        "grounding_chunk_indices": [
          0,
          1
        ],
        "segment": {
          "end_index": 186,
          "text": "KOTEKLI:\n* 2026-10-26 | altyapı/duyuru | Muğla'nın Menteşe ilçesi Kötekli Mahallesi'nde yağış nedeniyle yolda çökme meydana geldi ve bir araç çukura düşerek mahsur kaldı."
        }
      },
      {
        "grounding_chunk_indices": [
          2
        ],
        "segment": {
          "start_index": 264,
          "end_index": 385,
          "text": "katta bulunan bir dairede ocakta unutulan yağ nedeniyle yangın çıktı ve itfaiye ekipleri tarafından söndürüldü."
        }
      },
      {
        "grounding_chunk_indices": [
          3
        ],
        "segment": {
          "start_index": 386,
          "end_index": 545,
          "text": "* 2026-09-01 | suç/şiddet | Muğla'nın Menteşe ilçesi Kötekli Mahallesi'nde bir evde eski sevgililer silahla başlarından vurulmuş halde ölü bulundu."
        }
      },
      {
        "grounding_chunk_indices": [
          4
        ],
        "segment": {
          "start_index": 546,
          "end_index": 725,
          "text": "* 2026-08-15 | kamu hizmeti | Menteşe Kötekli Mahallesi Sıtkı Koçman Caddesi için hazırlanan Kötekli Cephe Sağlıklaştırma Projesi'nin tanıtım toplantısı yapıldı."
        }
      },
      {
        "grounding_chunk_indices": [
          5
        ],
        "segment": {
          "start_index": 726,
          "end_index": 938,
          "text": "* 2026-08-07 | altyapı/duyuru | Muğla Büyükşehir Belediyesi'nin Kötekli Mahallesi'nde yürüttüğü altyapı çalışmaları sırasında mezar buluntularına rastlanması üzerine çalışmalar durduruldu."
        }
      },
      {
        "grounding_chunk_indices": [
          6
        ],
        "segment": {
          "start_index": 939,
          "end_index": 1118,
          "text": "* 2026-04-22 | suç/şiddet | Muğla'nın Menteşe ilçesi Kötekli Mahallesi'nde bir vatandaşın içerisinde altınlar bulunan cüzdanı kayboldu ve ekipler tarafından bulundu."
        }
      },
      {
        "grounding_chunk_indices": [
          7
        ],
        "segment": {
          "start_index": 1297,
          "end_index": 1309,
          "text": "tutuklandı."
        }
      },
      {
        "grounding_chunk_indices": [
          8
        ],
        "segment": {
          "start_index": 1310,
          "end_index": 1525,
          "text": "* 2026-03-25 | kamu hizmeti | Menteşe Emirbeyazıt Mahallesi'nde hizmet veren 2 No'lu Aile Sağlığı Merkezi'nin taşınma kararı mahalle sakinleri arasında tepkiye yol açtı ve imza kampanyası başlatıldı."
        }
      },
      {
        "grounding_chunk_indices": [
          9
        ],
        "segment": {
          "start_index": 1526,
          "end_index": 1673,
          "text": "* 2025-11-07 | suç/şiddet | Emirbeyazıt Mahallesi'nde alacak-verecek meselesi yüzünden çıkan bıçaklı kavgada bir kişi ağır yaralandı."
        }
      },
      {
        "grounding_chunk_indices": [
          10
        ],
        "segment": {
          "start_index": 1674,
          "end_index": 1817,
          "text": "* 2025-08-08 | altyapı/duyuru | Menteşe Emirbeyazıt Mahallesi'nde bulunan ahşap bir direk, park halindeki iki otomobilin üzerine devrildi."
        }
      },
      {
        "grounding_chunk_indices": [
          11,
          12
        ],
        "segment": {
          "start_index": 1819,
          "end_index": 2005,
          "text": "MUSLIHITTIN:\n* 2026-04-14 | kamu hizmeti | Menteşe ilçesine bağlı Muslihittin Mahallesi'ndeki Şeyh Muslihittin Camii'ne leylekler yuva kurdu ve mahalle sakinlerinin ilgisini çekti."
        }
      },
      {
        "grounding_chunk_indices": [
          13
        ],
        "segment": {
          "start_index": 2006,
          "end_index": 2166,
          "text": "* 2025-08-25 | sağlık | Muğla'nın Menteşe ilçesi Muslihittin Mahallesi Cevizli Sokak'ta yaşanan intihar ihbarı üzerine ekipler olay yerine sevk edildi."
        }
      },
      {
        "grounding_chunk_indices": [
          14,
          15
        ],
        "segment": {
          "start_index": 2243,
          "end_index": 2367,
          "text": "Varışlı Sokak'ta kız meselesi yüzünden çıkan bıçaklı kavgada bir kişi hayatını kaybetti, iki kişi yaralandı."
        }
      },
      {
        "grounding_chunk_indices": [
          16
        ],
        "segment": {
          "start_index": 2368,
          "end_index": 2606,
          "text": "* 2026-10-16 | altyapı/duyuru | Muğla Büyükşehir Belediyesi, Menteşe Orhaniye Mahallesi Şehit Asteğmen Yıldıray Çeltiklioğlu Caddesi'nde yağmursuyu hattı, kaldırım, bisiklet yolu ve asfalt çalışmalarını sürdürüyor."
        }
      },
      {
        "grounding_chunk_indices": [
          17
        ],
        "segment": {
          "start_index": 2734,
          "end_index": 2813,
          "text": "Nuri Öncüer Huzurevi'nin yeniden inşaat çalışmaları hızla devam ediyor."
        }
      },
      {
        "grounding_chunk_indices": [
          17
        ],
        "segment": {
          "start_index": 2814,
          "end_index": 3020,
          "text": "* Bilinmiyor | altyapı/duyuru | MUSKİ Genel Müdürlüğü, Menteşe İlçesi Orhaniye Mahallesi Yıldıray Çeltiklioğlu Caddesi üzerinde ekonomik ömrünü tamamlayan içme suyu hatlarını yeniliyor."
        }
      },
      {
        "grounding_chunk_indices": [
          17
        ],
        "segment": {
          "start_index": 3021,
          "end_index": 3226,
          "text": "* Bilinmiyor | sağlık | Muğla'nın Menteşe ilçesine bağlı Orhaniye Mahallesi Karabağlar Yaylası mevkiinde çıkan ot yangını, itfaiye ekiplerinin hızlı müdahalesiyle kontrol altına alındı."
        }
      },
      {
        "grounding_chunk_indices": [
          18
        ],
        "segment": {
          "start_index": 3228,
          "end_index": 3410,
          "text": "AKYAKA:\n* 2026-09-12 | kamu hizmeti | Muğla'nın Ula ilçesine bağlı Akyaka Mahallesi'ndeki Akçapınar sahilinde 2026 Türk Telekom Formula Kite Avrupa Şampiyonası düzenlendi."
        }
      },
      {
        "grounding_chunk_indices": [
          18
        ],
        "segment": {
          "start_index": 3411,
          "end_index": 3569,
          "text": "* 2026-09-15 | altyapı/duyuru | Muğla'nın Ula ilçesine bağlı Akyaka Mahallesi'nde evlerin yakınındaki zeytinlik alanda çıkan yangın söndürüldü."
        }
      },
      {
        "grounding_chunk_indices": [
          19
        ],
        "segment": {
          "start_index": 3570,
          "end_index": 3765,
          "text": "* 2026-07-29 | kamu hizmeti | Akyaka Mahallesi'nde kıyı alanlarının işletmeler tarafından işgal edildiğini öne süren Gökova Ekolojik Yaşam Derneği, 17 ayrı suç duyurusunda bulundu."
        }
      },
      {
        "grounding_chunk_indices": [
          20
        ],
        "segment": {
          "start_index": 3766,
          "end_index": 3956,
          "text": "* 2026-05-18 | altyapı/duyuru | Muğla'nın Ula ilçesindeki Akyaka Mahallesi'nde deniz suyu aniden kıyıdan yaklaşık 80 ila 100 metre çekildi ve 2 dakika sonra eski seviyesine döndü."
        }
      },
      {
        "grounding_chunk_indices": [
          21
        ],
        "segment": {
          "start_index": 4129,
          "end_index": 4161,
          "text": "'ye verilmesine tepki gösterdi."
        }
      },
      {
        "grounding_chunk_indices": [
          22
        ],
        "segment": {
          "start_index": 4162,
          "end_index": 4405,
          "text": "* 2026-01-01 | kamu hizmeti | NASA'nın Dünya Günü'nde Instagram hesabından paylaştığı Kadın Azmağı'nın yer aldığı Akyaka Mahallesi, BM Turizm Örgütü tarafından \"En iyi turizm köyleri\" kapsamında ödüle layık görüldü."
        }
      },
      {
        "grounding_chunk_indices": [
          21
        ],
        "segment": {
          "start_index": 4406,
          "end_index": 4550,
          "text": "* Bilinmiyor | altyapı/duyuru | Menteşe ve Ula Belediyeleri, Akyaka Mahallesi Çınar mevkisinde kaçak yapılaşmaya karşı harekete geçti."
        }
      }
