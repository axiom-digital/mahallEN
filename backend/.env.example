# MahallEN Backend Configuration
APP_NAME="MahallEN API"
APP_ENV="development"
DEBUG=False

# SQLite works locally without credentials. Set DATABASE_URL explicitly for PostgreSQL.
DATABASE_URL="sqlite:///./mahallen_local.db"
# Optional development-only fallback. Database failures otherwise stop startup.
AUTO_FALLBACK_SQLITE=False

# Gemini AI API Key (Get from Google AI Studio: https://aistudio.google.com/)
# Leave empty to use the built-in smart deterministic fallback generator
GEMINI_API_KEY=""
# Choose a currently supported model as part of issue #9.
GEMINI_MODEL=""
# Optional operator-only live refresh; at least 32 random characters.
# Leave empty to disable live refresh. Never expose this through VITE_* variables.
AI_REFRESH_TOKEN=""

# CORS Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Persistent Report Cache (Issue #11)
REPORT_CACHE_ENABLED=True
REPORT_CACHE_TTL_SECONDS=86400
