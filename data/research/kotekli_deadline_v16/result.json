    "grounding_supports": [
      {
        "grounding_chunk_indices": [
          0
        ],
        "segment": {
          "start_index": 381,
          "end_index": 565,
          "text": "** Muğla Büyükşehir Belediyesi Fen İşleri Dairesi Başkanı Süleyman Soydemir, yol ve kaldırım çalışmalarının 15 Eylül'de tamamlanmasının hedeflendiğini belirtmişti."
        }
      },
      {
        "grounding_chunk_indices": [
          1,
          2
        ],
        "segment": {
          "start_index": 995,
          "end_index": 1206,
          "text": "Muğla Büyükşehir Belediyesi, arkeolojik inceleme sürecinin çalışma takvimini etkileyebileceğini belirtmekle birlikte, yolun 15 Eylül'de yeniden ulaşıma açılmasını hedeflediğini açıklamıştı."
        }
      },
      {
        "grounding_chunk_indices": [
          3
        ],
        "segment": {
          "start_index": 1340,
          "end_index": 1550,
          "text": "** Muğla Yenigün Gazetesi'nin 15 Eylül 2026 tarihli haberine göre, Sıtkı Koçman Caddesi'nin çalışmaların tamamlanan bölümü, belirtilen 15 Eylül tarihinden önce yeniden ulaşıma açılmıştır."
        }
      },
      {
        "grounding_chunk_indices": [
          4
        ],
        "segment": {
          "start_index": 1803,
          "end_index": 2102,
          "text": "** Muğla Gazetesi'nin 16 Eylül 2026 tarihli haberinde, Muğla Büyükşehir Belediyesi'nin 15 Eylül'de eğitim-öğretim yılına yetiştirmeyi hedeflediği projenin bazı bölümlerinin tamamlandığı, ancak projenin resmi bitiş tarihinin 3 Kasım 2026 olarak açıklandığı belirtilmiştir."
        }
      },
      {
        "grounding_chunk_indices": [
          3
        ],
        "segment": {
          "start_index": 2510,
          "end_index": 2670,
          "text": "Sokak Yol, Altyapı, Cadde, Bulvar ve Meydan Yenileme ve Düzenleme Yapılması\" işinin teslim tarihinin 3 Kasım 2026 olarak göründüğü ifade edilmiştir."
        }
      },
      {
        "grounding_chunk_indices": [
          5
        ],
        "segment": {
          "start_index": 2789,
          "end_index": 3074,
          "text": "** Muğla Sıtkı Koçman Üniversitesi Yapı İşleri ve Teknik Daire Başkanlığı'nın 19 Ekim 2026 tarihli duyurusuna göre, Kötekli Mahallesi'nde yürütülen çalışmalar nedeniyle Üniversite C Kapısı çalışmalar tamamlanıncaya kadar araç trafiğine kapalı olacaktır."
        }
      },
      {
        "grounding_chunk_indices": [
          6
        ],
        "segment": {
          "start_index": 3297,
          "end_index": 3602,
          "text": "** MHP Menteşe İlçe Başkanlığı, 14 Ekim 2026 tarihli açıklamasında, Kötekli, Yeniköy ve Ortaköy mahallelerinde devam eden yol ve çevre düzenleme çalışmalarının tamamlanmamasına tepki göstererek, çalışmaların tamamlanması için somut bir takvim açıklanmasını talep etmiştir."
        }
      },
      {
        "grounding_chunk_indices": [
          7
        ],
        "segment": {
          "start_index": 3779,
          "end_index": 3956,
          "text": "** Muğla Yenigün Gazetesi'nin 27 Ekim 2026 tarihli haberine göre, Kötekli Mahallesi'nde yağış nedeniyle yol çökmüş ve bir araç çukura düşerek mahsur kalmıştır."
        }
      },
      {
        "grounding_chunk_indices": [
          3,
          4
        ],
        "segment": {
          "start_index": 4214,
          "end_index": 4349,
          "text": "Sokak Yol, Altyapı, Cadde, Bulvar ve Meydan Yenileme ve Düzenleme Yapılması\" işinin resmi teslim tarihi olarak doğrulanmıştır."
        }
      }
    ],
