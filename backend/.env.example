# MahallEN Backend Configuration
APP_NAME="MahallEN API"
APP_ENV="development"
DEBUG=True

# Database Configuration (PostgreSQL via Docker or Local SQLite fallback if needed)
# Default Docker PostgreSQL URL:
DATABASE_URL="postgresql+psycopg2://mahallen_user:mahallen_pass@localhost:5432/mahallen_db"
# If PostgreSQL is not running locally, the app can automatically fall back to SQLite when AUTO_FALLBACK_SQLITE=True
AUTO_FALLBACK_SQLITE=True

# Gemini AI API Key (Get from Google AI Studio: https://aistudio.google.com/)
# Leave empty to use the built-in smart deterministic fallback generator
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
