# Docker Compose only. Copy to .env at the repository root.
POSTGRES_USER=mahallen_user
POSTGRES_DB=mahallen_db
# Required: use a random hex password (URL-safe for DATABASE_URL).
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for the M1 demo. Live integration is planned in issue #9.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_REFRESH_TOKEN=
REPORT_CACHE_ENABLED=True
REPORT_CACHE_TTL_SECONDS=86400
