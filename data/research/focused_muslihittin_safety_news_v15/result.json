        "segment": {
          "start_index": 181,
          "end_index": 348,
          "text": "| İhlas Haber Ajansı, Muğla Gazetesi\n* 2025-12-11 | yangın | Muslihittin Mahallesi Nergis Sokak'ta müstakil bir evde yangın çıktı, ev sahibi hafif yaralandı."
        }
      },
      {
        "grounding_chunk_indices": [
          3,
          4
        ],
        "segment": {
          "start_index": 349,
          "end_index": 521,
          "text": "| Muğla Yenigün Gazetesi\n* 2026-04-11 | trafik | Muslihittin Mahallesi Şehit Özden Aşınmaz Caddesi üzerinde otomobil ile motosiklet çarpıştı, 1 kişi yaralandı."
        }
      },
      {
        "grounding_chunk_indices": [
          5
        ],
        "segment": {
          "start_index": 522,
          "end_index": 659,
          "text": "| Muğla Yenigün Gazetesi, Muğla Haberleri\n* 2025-07-23 | yangın | Muslihittin Mahallesi'nde 3 adet boş konteynerde yangın çıktı."
        }
      },
      {
        "grounding_chunk_indices": [
          6
        ],
        "segment": {
          "start_index": 660,
          "end_index": 935,
          "text": "| Muğla Gazetesi\n* 2025-09-27 | altyapı/duyuru | Muğla Büyükşehir Belediyesi tarafından Muslihittin Mahallesi'nde yeşil alanların sulanması için yapılan su deposu çalışmalarında tarihi eserler bulundu, çalışmalar durduruldu ve alan koruma altına alındı."
        }
      },
      {
        "grounding_chunk_indices": [
          7
        ],
        "segment": {
          "start_index": 936,
          "end_index": 1115,
          "text": "| Yeni Şafak\n* 2026-10-18 | kesinti | Muslihittin Mahallesi'nde bulunan Muğla Katı Atık Tesisi ve Menteşe Katı Atık Biyokütle ÖTM'de planlı elektrik kesintisi yaşandı."
        }
      },
      {
        "grounding_chunk_indices": [
          8
        ],
        "segment": {
          "start_index": 1116,
          "end_index": 1318,
          "text": "| Aydem\n* 2024-12-03 | altyapı/duyuru | Menteşe Belediye Meclisi kararıyla Muslihittin Mahallesi altında, 15 metrelik imar yoluna \"852 Cadde\" ve 12 metrelik imar yoluna \"854 Sokak\" isimleri verildi."
        }
